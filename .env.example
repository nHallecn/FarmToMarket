# FarmToMarket Copilot requires an OpenAI API key. Keep it server-only: never add
# NEXT_PUBLIC_ to this variable or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Local PostgreSQL started by `docker compose up -d postgres`.
# Replace the credentials and host with managed PostgreSQL values in production.
DATABASE_URL=postgresql://farmtomarket:farmtomarket_dev@localhost:5432/farmtomarket?schema=public

# The browser state-sync/reset endpoints are intentionally disabled in production
# unless this deployment is an isolated demo environment.
ALLOW_DEMO_STATE_READS=false
ALLOW_DEMO_STATE_WRITES=false
ALLOW_DEMO_RESET=false

# Production integrations should be supplied through server-only environment variables.
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER_SECRET=
OBJECT_STORAGE_SECRET=
NEXT_PUBLIC_MAP_PROVIDER_KEY=
