# The core interactive prototype requires no secrets.
# FarmToMarket Copilot requires an OpenAI API key. Keep it server-only: never add
# NEXT_PUBLIC_ to this variable or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Production integrations should be supplied through server-only environment variables.
DATABASE_URL=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER_SECRET=
OBJECT_STORAGE_SECRET=
NEXT_PUBLIC_MAP_PROVIDER_KEY=
